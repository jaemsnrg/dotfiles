# Ghostty Auto Light/Dark Switch
theme = dark:Catppuccin Macchiato,light:Catppuccin Latte


# ==========================================
# Opacity, Blur & Window Polish (macOS)
# ==========================================

# Background Transparency + Blur
background-opacity = 0.9
background-blur-radius = 20

# Custom Cursor Styles
cursor-style = bar
cursor-style-blink = true

# macOS Window Blur (higher = softer background bleed)
background-blur-radius = 20

# Hide the bulky top title bar for a seamless, borderless look
macos-titlebar-style = hidden

# Optional: Add padding inside the window so text doesn't touch screen edges
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# ==========================================
# Keybindings
# ==========================================

# Unbind Ghostty's native split-right so it doesn't intercept cmd+d
keybind = cmd+d=unbind

# Send the byte for Ctrl+A (0x01) when cmd+d is pressed
keybind = cmd+d=text:\x01

# Map Cmd+E to send Alt+E to the shell/fzf
keybind = cmd+e=text:\x1be

# Map Cmd+R to send Alt+R to the shell/fzf
keybind = cmd+r=text:\x1br
