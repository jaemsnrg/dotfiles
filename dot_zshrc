# Load Nix environment
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

# --- Path Deduplication & Global System Paths ---
typeset -U path PATH
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# --- Node Version Manager (NVM) ---
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# --- PNPM ---
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# --- IDE & Custom Binaries ---
if [ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]; then
  export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
fi

# --- Default Editors & Pager ---
export EDITOR="micro"
export VISUAL="micro"
export PAGER="cat"
export MICRO_TRUECOLOR=1

# --- Custom Aliases ---
if [ -f "$HOME/.aliases" ]; then
    source "$HOME/.aliases"
fi

# --- Modular config: ~/.config/zsh/*.zsh (loaded in filename order) ---
#   10-fzf  20-git  30-terminal  40-dev-tools  50-perf  git-repos
for f in "$HOME"/.config/zsh/*.zsh(N); do source "$f"; done
