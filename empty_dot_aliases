# Git basics
alias g='git'
alias gr='git remote -v'
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -m'
alias gac='git add -A && git commit -m'
alias gca='git commit --amend'
alias gco='git checkout'
alias gb='git branch'
alias gbc='git branch --show-current'
alias gcob='git checkout -b'
alias gbd='git branch -d'
alias gm='git merge'
alias gcl='git clone'
alias gt='git tag'
alias gpt='git push --tags'
alias gsl="git stash list --date=relative"

# Sync & remote
alias gp='git push'
alias gpf='git push --force-with-lease' # Safer force push
alias gf='git fetch --all --prune'      # Fetch and trim deleted remote branches
alias gcompareremote='git log --oneline --graph --left-right HEAD...@{upstream}'

# Visual logs & diffs
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --graph --color=always --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit | tac'

# Chezmoi workflow
alias cz='chezmoi'
alias czadd='chezmoi add'
alias czreadd='chezmoi re-add'
alias czl='chezmoi list'
alias cza='chezmoi apply'
alias cze='chezmoi edit --apply'
alias czd='chezmoi diff'
alias czs='chezmoi status'
alias czcd='cd $(chezmoi source-path)'  # Jump directly to source repo
alias czu='chezmoi update'             # Pull latest remote changes & apply

# Tmux shortcuts
alias t="tmux attach-session -t main 2>/dev/null || tmux new-session -s main"
alias ta='tmux attach'                  # Attach to last session
alias tat='tmux attach -t'              # Attach to specific session: tat <name>
alias tls='tmux ls'                     # List sessions
alias tk='tmux kill-session -t'         # Kill specific session: tk <name>
alias tka='tmux kill-session -a'        # Kill all sessions except current
alias tkall='tmux kill-server'          # Kill all sessions and server
alias tapp='tmux source "${TMUX_CONFIG:-$([ -f ~/.config/tmux/tmux.conf ] && echo ~/.config/tmux/tmux.conf || echo ~/.tmux.conf)}"' # Reload active tmux config dynamically

# Alias master refresh
alias reload='source "${ZDOTDIR:-$HOME}/.zshrc" 2>/dev/null || source ~/.bashrc; [ -n "$TMUX" ] && tmux source "${TMUX_CONFIG:-$([ -f ~/.config/tmux/tmux.conf ] && echo ~/.config/tmux/tmux.conf || echo ~/.tmux.conf)}" && echo "Shell & Tmux configs reloaded!" || echo "Shell config reloaded!"'

