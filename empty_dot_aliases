# General

alias c='clear'
alias lsa='ls -a'
alias x="glow \"\$(chezmoi source-path)/CHEATSHEET.md\" -p"
alias offtimer='sudo shutdown -h' # in minutes eg. +60 = 1hr

# Aliases
alias czcat='chezmoi cat ~/.aliases'
alias ea="chezmoi edit --apply ~/.aliases"

# Edit Hotkey Cheatsheet
alias xx='open "$(chezmoi source-path)/CHEATSHEET.md"'

# Temporary

alias dsr='./run.sh'

# Test changes

alias etest='echo "applied 4"'

# Docker
alias d="docker"
alias dcls='docker container ls'
alias dps="docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'"
alias dlogs="docker logs -f --tail 100"

alias dstop="docker stop"
alias dkill="docker kill"
alias drestart="docker restart"
alias dexec="docker exec -it"   # Usage: dexec <container_name> sh (or bash)

# Docker Compose Shortcuts
alias dcup="docker compose up -d"
alias dcdown="docker compose down"
alias dclogs="docker compose logs -f"
alias dcps="docker compose ps"

# Docker System Cleanup
alias dclean="docker system prune -af --volumes"
