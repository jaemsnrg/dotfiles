# General

alias c='clear'
alias lsa='ls -a'
alias x="glow \"\$(chezmoi source-path)/CHEATSHEET.md\" -p"


# List Aliases
alias czcat='chezmoi cat ~/.aliases'

# Edit Hotkey Cheatsheet
alias xx='open "$(chezmoi source-path)/CHEATSHEET.md"'

# Test changes

alias etest='echo "applied 4"'
